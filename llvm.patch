+   if (Optimized) {
+       if (EnableILPRegAlloc &&
+           TM->getMCSubtargetInfo()->hasFeature(RISCV::FeatureStdExtC)) {
+           addPass(createGreedyRegisterAllocator());
+           return createRISCVILPRegAlloc();
+       }
